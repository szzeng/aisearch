# Python tools cache
.pytest_cache/
.pytest-tmp/
# Fallback basetemp when the restricted token cannot write `.pytest-tmp` (WinError 5 on this
# machine): still a project-local, throw-away directory, never part of the source tree.
.pytest-basetemp-*/
.ruff_cache/
.uv-cache/

# Test reports
test-results/

# Throw-away copies of the frozen bundle used by the C-level degraded acceptance
# (tools/diagnostics/heif_degraded_bundle.py): a full onedir tree, never a source artifact.
.packaged-*/

# Build output
build/
dist/
*.spec

