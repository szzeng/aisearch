.venv/
__pycache__/
*.py[cod]

# Python tools cache
.pytest_cache/
.pytest-tmp/
.pytest-tmp*/
.codex-remote-attachments/
# Fallback basetemp when the restricted token cannot write `.pytest-tmp` (WinError 5 on this
# machine): still a project-local, throw-away directory, never part of the source tree.
.pytest-basetemp-*/
.ruff_cache/
.uv-cache/

# Test reports
test-results/
# Raw test/benchmark/browser outputs are local or CI artifacts, not source changes.
/docs/reports/artifacts/

# Throw-away copies of the frozen bundle used by the C-level degraded acceptance
# (tools/diagnostics/heif_degraded_bundle.py): a full onedir tree, never a source artifact.
.packaged-*/

# Build output
build/
dist/
/releases/
# Generated root-level PyInstaller specs; checked-in packaging specs remain visible.
/*.spec

# Local runtime data
# Root-only: nested runtime/data directories may contain application or test source.
/runtime/
/data/
/tmp/
/temp/

# AI models and generated assets
/models/
/embeddings/
/indexes/
*.bin
*.onnx
*.pt
*.pth
*.safetensors

# Local databases
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Logs
*.log
.tmp/
# Local deployment data may include model weights and provider credentials.
/PhotoSearchData/
# Local deployment bundles, not ZIP fixtures stored under tests/.
/PhotoSearch*_Deploy_Pack.zip

# Local credentials; templates with placeholder values belong in source control.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# IDE / editor
.vscode/
.idea/

# Codex local files
.codex/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# The pinned MapLibre browser bundle is source code, not generated build output.
!/src/photo_search/web/vendor/maplibre-4.7.1/dist/
!/src/photo_search/web/vendor/maplibre-4.7.1/dist/*
