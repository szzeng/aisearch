{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photo-search.local/contracts/p4-a3-contracts.v1.json",
  "title": "Photo Search P4-02G / ADR-0012 A3 eligibility, certificate and fallback contract",
  "description": "Derived from ADR-0012-a3-global-candidate-contract.md. Contract only: A3 is NOT implemented and NOT enabled. Any A3 publication requires one of the certificate mechanisms, and every other state must fall back to the complete authoritative candidate-block path.",
  "oneOf": [
    { "$ref": "#/$defs/A3Request" }
  ],
  "$defs": {
    "ContractVersion": { "const": "p4-a3-contracts.v1" },
    "RulesVersion": { "const": 1 },
    "SearchContractVersion": { "const": "p2-contracts.v1" },
    "MaxTopK": { "const": 1000 },
    "MinTopK": { "const": 1 },
    "OrderKey": {
      "description": "The published total order. Truncation may only happen after this order is applied.",
      "const": ["distance", "asset_id"]
    },
    "CertificateMechanism": {
      "enum": ["M1_EQUIVALENT_SNAPSHOT", "M2_PUSHDOWN_EQUIVALENCE", "M3_STOP_CERTIFICATE"]
    },
    "EngineSideGate": {
      "description": "ADR-0012 section 3.3: the engine-side gate is per mechanism; equality of the whole physical row set is M1's requirement only.",
      "enum": [
        "M1_PHYSICAL_SET_EQUALS_C_STRICT",
        "M2_PUSHDOWN_RESTRICTED_SET_EQUALS_C_STRICT",
        "M3_STOP_CERTIFICATE_OVER_ENGINE_STREAM"
      ]
    },
    "ForbiddenMechanism": {
      "enum": [
        "FIXED_OVERFETCH_MULTIPLIER",
        "FIXED_RETRY_COUNT",
        "GLOBAL_TOP_K_THEN_FILTER",
        "COUNT_ONLY_EQUALITY",
        "SAMPLING_ONLY_EQUALITY",
        "INDEX_EXISTENCE_AS_QUALIFICATION",
        "ENGINE_TRUNCATION_BEFORE_TOTAL_ORDER"
      ]
    },
    "Decision": {
      "enum": ["A3_WITH_CERTIFICATE", "FALLBACK_COMPLETE_PATH"]
    },
    "FallbackReason": {
      "enum": [
        "NOT_ELIGIBLE_EXTRA_SCOPE",
        "NOT_ELIGIBLE_FILTER_ONLY",
        "NOT_ELIGIBLE_INCOMPLETE_BINDING",
        "BINDING_NOT_READY",
        "UNCONFIRMED_ROW_IN_ENGINE",
        "PENDING_REPAIR_ENTRY",
        "STALE_OR_DUPLICATE_REVISION",
        "MISSING_ENGINE_ROW",
        "REVISION_OR_VISIBILITY_CHANGED_BEFORE_PUBLICATION",
        "NO_CERTIFICATE_PROVABLE"
      ]
    },
    "EligibilityRule": {
      "type": "object",
      "description": "ADR-0012 section 2: every field must hold for A3 to be even considered.",
      "required": [
        "full_vector_binding",
        "semantic_query",
        "source_id_is_null",
        "availability_is_any",
        "place_ids_is_empty",
        "place_state_is_any",
        "person_ids_is_empty",
        "capture_is_null",
        "generation_state_ready",
        "space_and_dimension_match"
      ],
      "additionalProperties": false,
      "properties": {
        "full_vector_binding": { "const": true },
        "semantic_query": { "const": true },
        "source_id_is_null": { "const": true },
        "availability_is_any": { "const": true },
        "place_ids_is_empty": { "const": true },
        "place_state_is_any": { "const": true },
        "person_ids_is_empty": { "const": true },
        "capture_is_null": { "const": true },
        "generation_state_ready": { "const": true },
        "space_and_dimension_match": { "const": true }
      }
    },
    "AuthoritySetRule": {
      "type": "object",
      "description": "ADR-0012 section 3: the oracle membership set C_sql (exactly what _CONFIRMED_BLOCK_SQL selects) and the stronger certificate set C_strict (row-level consistent).",
      "required": [
        "oracle_membership_matches_confirmed_block_sql",
        "entry_state_confirmed",
        "strict_requires_one_row_per_generation_asset",
        "strict_requires_row_revision_equals_confirmation_revision",
        "strict_is_a_subset_of_oracle_membership",
        "mismatch_forces_fallback",
        "lance_visible_column_is_not_a_credential"
      ],
      "properties": {
        "oracle_membership_matches_confirmed_block_sql": { "const": true },
        "entry_state_confirmed": { "const": true },
        "strict_requires_one_row_per_generation_asset": { "const": true },
        "strict_requires_row_revision_equals_confirmation_revision": { "const": true },
        "strict_is_a_subset_of_oracle_membership": { "const": true },
        "mismatch_forces_fallback": { "const": true },
        "lance_visible_column_is_not_a_credential": { "const": true }
      }
    },
    "CertificateRule": {
      "description": "ADR-0012 section 3.3/4: each mechanism is bound to exactly one engine-side gate, and the certificate must still hold at publication time. Cross pairings are rejected here, not only in prose.",
      "oneOf": [
        { "$ref": "#/$defs/M1Certificate" },
        { "$ref": "#/$defs/M2Certificate" },
        { "$ref": "#/$defs/M3Certificate" }
      ]
    },
    "M1Certificate": {
      "type": "object",
      "required": ["mechanism", "engine_side_gate", "holds_at_publication", "evidence"],
      "additionalProperties": false,
      "properties": {
        "mechanism": { "const": "M1_EQUIVALENT_SNAPSHOT" },
        "engine_side_gate": { "const": "M1_PHYSICAL_SET_EQUALS_C_STRICT" },
        "holds_at_publication": { "const": true },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "M2Certificate": {
      "type": "object",
      "required": ["mechanism", "engine_side_gate", "holds_at_publication", "evidence"],
      "additionalProperties": false,
      "properties": {
        "mechanism": { "const": "M2_PUSHDOWN_EQUIVALENCE" },
        "engine_side_gate": { "const": "M2_PUSHDOWN_RESTRICTED_SET_EQUALS_C_STRICT" },
        "holds_at_publication": { "const": true },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "M3Certificate": {
      "type": "object",
      "description": "M3 needs no row-set equality, but it does need a decidable stop certificate over the engine row stream; rows it inspected and judged unqualified by the same authoritative view may be nearer.",
      "required": ["mechanism", "engine_side_gate", "holds_at_publication", "evidence"],
      "additionalProperties": false,
      "properties": {
        "mechanism": { "const": "M3_STOP_CERTIFICATE" },
        "engine_side_gate": { "const": "M3_STOP_CERTIFICATE_OVER_ENGINE_STREAM" },
        "holds_at_publication": { "const": true },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "StateMatrixRow": {
      "type": "object",
      "description": "ADR-0012 section 6: one frozen counterexample class and its decided outcome.",
      "required": ["case", "engine_state", "authority_state", "decision", "fallback_reason"],
      "additionalProperties": false,
      "properties": {
        "case": {
          "enum": [
            "unconfirmed_row",
            "pending_repair",
            "stale_or_duplicate_revision",
            "missing_engine_row",
            "tied_distance",
            "hidden_offline_or_source_change",
            "generation_or_space_switch",
            "concurrent_publication",
            "place_state_filter",
            "extra_engine_row_with_m3_certificate",
            "positive_control_certificate"
          ]
        },
        "engine_state": { "type": "string", "minLength": 1 },
        "authority_state": { "type": "string", "minLength": 1 },
        "decision": { "$ref": "#/$defs/Decision" },
        "fallback_reason": {
          "oneOf": [
            { "$ref": "#/$defs/FallbackReason" },
            { "type": "null" }
          ]
        },
        "published_page_equals_complete_path": { "const": true }
      }
    },
    "A3Request": {
      "description": "One A3 decision record. O-2: the decision is bound to its certificate here, so 'publish with A3' without a non-null mechanism-bound certificate is rejected by the machine contract, not only by prose.",
      "oneOf": [
        { "$ref": "#/$defs/A3PublishDecision" },
        { "$ref": "#/$defs/A3FallbackDecision" }
      ]
    },
    "A3PublishDecision": {
      "type": "object",
      "required": [
        "contract_version",
        "rules_version",
        "eligibility",
        "authority_set",
        "top_k",
        "order_key",
        "decision",
        "certificate",
        "fallback_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "rules_version": { "$ref": "#/$defs/RulesVersion" },
        "eligibility": { "$ref": "#/$defs/EligibilityRule" },
        "authority_set": { "$ref": "#/$defs/AuthoritySetRule" },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "order_key": { "$ref": "#/$defs/OrderKey" },
        "decision": { "const": "A3_WITH_CERTIFICATE" },
        "certificate": { "$ref": "#/$defs/CertificateRule" },
        "fallback_reason": { "const": null }
      }
    },
    "A3FallbackDecision": {
      "type": "object",
      "required": [
        "contract_version",
        "rules_version",
        "eligibility",
        "authority_set",
        "top_k",
        "order_key",
        "decision",
        "certificate",
        "fallback_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "rules_version": { "$ref": "#/$defs/RulesVersion" },
        "eligibility": { "$ref": "#/$defs/EligibilityRule" },
        "authority_set": { "$ref": "#/$defs/AuthoritySetRule" },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "order_key": { "$ref": "#/$defs/OrderKey" },
        "decision": { "const": "FALLBACK_COMPLETE_PATH" },
        "certificate": {
          "oneOf": [
            { "$ref": "#/$defs/CertificateRule" },
            { "type": "null" }
          ]
        },
        "fallback_reason": { "$ref": "#/$defs/FallbackReason" }
      }
    }
  }
}
